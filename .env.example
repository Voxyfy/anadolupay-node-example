# AnadoluPay Node.js örnek projesi — ortam değişkenleri
#
# Bu dosyadaki değişken adları anadolupay-laravel/anadolupay PHP
# projesindeki config/anadolupay.php'de kullanılanlarla BİREBİR aynıdır;
# aynı .env dosyasını (ya da içeriğini) her iki projede de kullanabilirsiniz.
#
# Sadece test etmek istediğiniz sürücülerin alanlarını doldurun; boş
# bırakılan sürücüler yalnızca çağrıldıklarında hata verir, uygulamayı
# başlatmaz.

# --- Sunucu ---
PORT=4000
SERVER_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# --- Sipariş numarası ---
ANADOLUPAY_ORDER_PREFIX=ODM-

# --- iyzico ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=

# --- Asseco / Payten (NestPay) ailesi ---
AKBANK_MERCHANT_ID=
AKBANK_USERNAME=
AKBANK_PASSWORD=
AKBANK_SECRET_KEY=
AKBANK_TEST_MODE=true

ISBANK_MERCHANT_ID=
ISBANK_USERNAME=
ISBANK_PASSWORD=
ISBANK_SECRET_KEY=
ISBANK_TEST_MODE=true

ZIRAAT_MERCHANT_ID=
ZIRAAT_USERNAME=
ZIRAAT_PASSWORD=
ZIRAAT_SECRET_KEY=
ZIRAAT_TEST_MODE=true

HALKBANK_MERCHANT_ID=
HALKBANK_USERNAME=
HALKBANK_PASSWORD=
HALKBANK_SECRET_KEY=
HALKBANK_TEST_MODE=true

QNB_MERCHANT_ID=
QNB_USERNAME=
QNB_PASSWORD=
QNB_SECRET_KEY=
QNB_TEST_MODE=true

TEB_MERCHANT_ID=
TEB_USERNAME=
TEB_PASSWORD=
TEB_SECRET_KEY=
TEB_TEST_MODE=true

SEKERBANK_MERCHANT_ID=
SEKERBANK_USERNAME=
SEKERBANK_PASSWORD=
SEKERBANK_SECRET_KEY=
SEKERBANK_TEST_MODE=true

ING_MERCHANT_ID=
ING_USERNAME=
ING_PASSWORD=
ING_SECRET_KEY=
ING_TEST_MODE=true

ALTERNATIFBANK_MERCHANT_ID=
ALTERNATIFBANK_USERNAME=
ALTERNATIFBANK_PASSWORD=
ALTERNATIFBANK_SECRET_KEY=
ALTERNATIFBANK_TEST_MODE=true

TURKIYEFINANS_MERCHANT_ID=
TURKIYEFINANS_USERNAME=
TURKIYEFINANS_PASSWORD=
TURKIYEFINANS_SECRET_KEY=
TURKIYEFINANS_TEST_MODE=true

# --- Garanti BBVA (GVPS) ---
GARANTI_MERCHANT_ID=
GARANTI_TERMINAL_ID=
GARANTI_USERNAME=
GARANTI_PASSWORD=
GARANTI_SECRET_KEY=
GARANTI_REFUND_USERNAME=
GARANTI_REFUND_PASSWORD=
# Yalnızca bayi (alt üye işyeri) yapılandırmalı terminaller için; boşsa
# istekler alanı hiç içermez. Yol, bankanın bayi tanımına göre taşınabilir.
GARANTI_SUB_MERCHANT_ID=
GARANTI_SUB_MERCHANT_ID_PATH=SubMerchantID
GARANTI_TEST_MODE=true

# --- Yapı Kredi (PosNet) ---
YAPIKREDI_MERCHANT_ID=
YAPIKREDI_TERMINAL_ID=
YAPIKREDI_POSNET_ID=
YAPIKREDI_SECRET_KEY=
YAPIKREDI_TEST_MODE=true

# --- Albaraka Türk (PosNet V1) ---
ALBARAKA_MERCHANT_ID=
ALBARAKA_TERMINAL_ID=
ALBARAKA_POSNET_ID=
ALBARAKA_SECRET_KEY=
ALBARAKA_TEST_MODE=true

# --- VakıfBank (PayFlex V4) ---
VAKIFBANK_MERCHANT_ID=
VAKIFBANK_TERMINAL_ID=
VAKIFBANK_PASSWORD=
VAKIFBANK_TEST_MODE=true

# --- Ziraat Bankası (PayFlex V4) ---
ZIRAAT_PAYFLEX_MERCHANT_ID=
ZIRAAT_PAYFLEX_TERMINAL_ID=
ZIRAAT_PAYFLEX_PASSWORD=
ZIRAAT_PAYFLEX_TEST_MODE=true

# --- DenizBank (InterPos) ---
DENIZBANK_MERCHANT_ID=
DENIZBANK_USERNAME=
DENIZBANK_PASSWORD=
DENIZBANK_SECRET_KEY=
DENIZBANK_TEST_MODE=true

# --- QNB Finansbank / Enpara (PayFor) ---
QNB_PAYFOR_MERCHANT_ID=
QNB_PAYFOR_USERNAME=
QNB_PAYFOR_PASSWORD=
QNB_PAYFOR_SECRET_KEY=
QNB_PAYFOR_TEST_MODE=true

# --- Ziraat Katılım (PayFor) ---
ZIRAAT_KATILIM_MERCHANT_ID=
ZIRAAT_KATILIM_USERNAME=
ZIRAAT_KATILIM_PASSWORD=
ZIRAAT_KATILIM_SECRET_KEY=
ZIRAAT_KATILIM_VERIFY_HASH=false
ZIRAAT_KATILIM_TEST_MODE=true

# --- Kuveyt Türk (BOA) ---
KUVEYTTURK_MERCHANT_ID=
KUVEYTTURK_USERNAME=
KUVEYTTURK_SECRET_KEY=
KUVEYTTURK_CUSTOMER_ID=
KUVEYTTURK_TEST_MODE=true

# --- Vakıf Katılım (BOA) ---
VAKIF_KATILIM_MERCHANT_ID=
VAKIF_KATILIM_USERNAME=
VAKIF_KATILIM_SECRET_KEY=
VAKIF_KATILIM_CUSTOMER_ID=
VAKIF_KATILIM_SUB_MERCHANT_ID=0
VAKIF_KATILIM_TEST_MODE=true

# --- Akbank (yeni JSON API) ---
AKBANK_POS_MERCHANT_SAFE_ID=
AKBANK_POS_TERMINAL_SAFE_ID=
AKBANK_POS_SECRET_KEY=
AKBANK_POS_TEST_MODE=true

# --- PayTR ---
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true

# --- Tosla (AkÖde) ---
TOSLA_CLIENT_ID=
TOSLA_API_USER=
TOSLA_API_PASS=
TOSLA_TEST_MODE=true

# --- Paycell (Turkcell) ---
PAYCELL_MERCHANT_CODE=
PAYCELL_APPLICATION_NAME=
PAYCELL_APPLICATION_PWD=
PAYCELL_SECURE_CODE=
PAYCELL_MSISDN=
PAYCELL_TEST_MODE=true

# --- Paratika (Payten) ---
PARATIKA_MERCHANT=
PARATIKA_MERCHANT_USER=
PARATIKA_MERCHANT_PASSWORD=
PARATIKA_SECRET_KEY=
PARATIKA_TEST_MODE=true

# --- Moka United ---
MOKA_DEALER_CODE=
MOKA_USERNAME=
MOKA_PASSWORD=
MOKA_TEST_MODE=true

# --- Craftgate ---
CRAFTGATE_API_KEY=
CRAFTGATE_SECRET_KEY=
CRAFTGATE_CALLBACK_KEY=
CRAFTGATE_HOOK_KEY=
CRAFTGATE_PAYMENT_API=https://sandbox-api.craftgate.io
CRAFTGATE_TEST_MODE=true

# --- Tami ---
# NOT: TamiGateway @voxyfy/anadolupay@1.3.0 ile geldi; bu sürücüyü
# kullanmadan önce `npm update @voxyfy/anadolupay` çalıştırın.
# username/password burada JWK kid/k çiftidir, secret_key'den ayrı bir anahtar.
TAMI_MERCHANT_NUMBER=
TAMI_TERMINAL_NUMBER=
TAMI_SECRET_KEY=
TAMI_JWK_KID=
TAMI_JWK_K=
# securityHash/hashedData formülü Tami tarafından resmen doğrulanmadı;
# gerçek kimlikle test ederken riski bilerek true'ya çevirin.
TAMI_VERIFY_HASH=false
TAMI_PAYMENT_API=https://sandbox-paymentapi.tami.com.tr
TAMI_TEST_MODE=true
